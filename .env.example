# ===========================================
# Composition Assistant Configuration
# ===========================================
# Copy this file to .env and fill in your values
# Or run: ./scripts/setup-env.sh

# ---- Ollama Configuration ----
# Local Ollama instance
OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:7b

# ---- Audio Processing ----
# Path to SoundFont directory on host (will be mounted to /app/FluidR3_GM)
# Use one of these depending on where your SoundFont is located:
SOUNDFONT_DIR=./transcriptionLibs/FluidR3_GM
# SOUNDFONT_DIR=./FluidR3_GM

# Path to SoundFont file inside container
SOUNDFONT_PATH=/app/FluidR3_GM/FluidR3_GM.sf2

# ---- Server Configuration ----
API_HOST=0.0.0.0
API_PORT=8000
UI_PORT=3000

# ---- Logging ----
LOG_LEVEL=INFO
PYTHONUNBUFFERED=1

# ---- Optional: External Ollama Cloud ----
# Uncomment and configure if using Ollama Cloud instead of local
# OLLAMA_API_KEY=
# OLLAMA_HOST=https://api.ollama.com
